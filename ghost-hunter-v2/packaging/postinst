#!/bin/sh
set -e
getent passwd | while IFS=: read -r name _ uid _ _ home _; do
  [ "$uid" -ge 1000 ] 2>/dev/null || continue
  [ "$uid" -lt 65534 ] || continue
  case "$home" in
    /home/*) ;;
    *) continue ;;
  esac
  for grp in spi gpio i2c video input audio; do
    if getent group "$grp" >/dev/null; then
      usermod -aG "$grp" "$name" || true
    fi
  done
done
if [ -e /sys/class/leds/ext_5v_out/brightness ]; then
  chmod 666 /sys/class/leds/ext_5v_out/brightness || true
fi
cat > /etc/udev/rules.d/99-ghost-hunter-ext5v.rules <<'EOF'
SUBSYSTEM=="leds", KERNEL=="ext_5v_out", MODE="0666"
EOF
udevadm control --reload-rules >/dev/null 2>&1 || true
exit 0
